# Production build of a MeetGo web site (user site or administration), served by nginx.
# Build from the repository root (it needs src/frontend/, lang/ and assets/branding/):
#   docker build -f docker/Dockerfile.web --build-arg VITE_ROOT=web_user --build-arg VITE_API_BASE=https://api.meetgo.app .
FROM node:20-alpine AS build
WORKDIR /srv/src/frontend
COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src/frontend/ ./
COPY lang/ /srv/lang/
COPY assets/branding/ /srv/assets/branding/
ARG VITE_ROOT=web_user
ARG VITE_API_BASE=https://api.meetgo.app
RUN VITE_ROOT=$VITE_ROOT VITE_API_BASE=$VITE_API_BASE ./node_modules/.bin/vite build

FROM nginx:1.27-alpine
ARG VITE_ROOT=web_user
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /srv/src/frontend/dist/${VITE_ROOT} /usr/share/nginx/html
# Some hosts (Synology ACL shares) send the build context with mode 000: nginx must be able to read the files.
RUN chmod -R a+rX /usr/share/nginx/html
EXPOSE 80
