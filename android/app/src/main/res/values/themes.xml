<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- the app after the start screen: the web app fills it; this is only what shows behind it -->
    <style name="Theme.MeetGo" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/meetgo_background</item>
    </style>

    <!-- start screen: the MeetGo arrow on the night background while the web app loads -->
    <style name="Theme.MeetGo.Start" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/meetgo_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.MeetGo</item>
    </style>
</resources>
