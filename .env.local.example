# Copy to .env.local (never commit it) and replace every value.
# Generate random values with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# First administrator, created only when no administrator exists.
# Leave ADMIN_PASSWORD empty to get a random one printed once in the app logs.
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=

# Browser origins allowed to call the API.
CORS_ORIGINS=https://meetgo.app,https://www.meetgo.app,https://admin.meetgo.app

# Public address of the API (links in notifications, Stripe webhook URL shown in the admin panel).
PUBLIC_API_BASE=https://api.meetgo.app

# SHA-256 fingerprint of the Android signing certificate, for App Links (see tools/android-keystore.sh).
ANDROID_CERT_SHA256=
